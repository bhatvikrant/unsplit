# ---- Frontend (.env.local, written by `npx convex dev`) ----
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# ---- Convex deployment env (set with `npx convex env set NAME value`, or the dashboard) ----
# Required for auth. Generate with: npm run auth:setup   (or node scripts/gen-auth-keys.mjs)
JWT_PRIVATE_KEY=
JWKS=
# Where the app is served; used in emails and OAuth redirects.
SITE_URL=http://localhost:5173

# Google sign-in (optional). Redirect URI: <CONVEX_SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email via Resend (optional). Without it, invites are links and password reset is unavailable.
RESEND_API_KEY=
EMAIL_FROM=UnSplit <noreply@yourdomain.com>

# Receipt scanning via the Claude API (optional).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
