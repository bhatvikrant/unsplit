{
  "name": "unsplit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:backend": "CONVEX_AGENT_MODE=anonymous convex dev",
    "dev:all": "CONVEX_AGENT_MODE=anonymous convex dev --start vite",
    "dev:cloud": "convex dev --env-file .env.cloud.local --start 'vite --mode cloud'",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "auth:keys": "node scripts/gen-auth-keys.mjs",
    "auth:setup": "./scripts/setup-auth-env.sh",
    "deploy": "./scripts/deploy.sh",
    "env:prod": "./scripts/prod-env.sh",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p convex/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "convex": "^1.46.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.2.0",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
